FROM debian:bookworm-slim

# Install minimal runtime dependencies and create an unprivileged user
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip libfontconfig1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash sandboxuser

# Download Godot 4 Linux binary (replace version as needed)
RUN curl -L https://github.com/godotengine/godot/releases/download/4.7.2-stable/Godot_v4.7.2-stable_linux.x86_64.zip -o godot.zip \
    && unzip godot.zip \
    && mv Godot_v4.7.2-stable_linux.x86_64 /usr/local/bin/godot \
    && chmod +x /usr/local/bin/godot \
    && rm godot.zip

USER sandboxuser
WORKDIR /sandbox
ENTRYPOINT ["godot", "--headless"]
